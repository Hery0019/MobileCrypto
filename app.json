{
  "expo": {
    "name": "mobileCrypto",
    "slug": "mobileCrypto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon2.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "fade": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rvtox.mobileCrypto",
      "buildNumber": "1.0.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon2.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.rvtox.mobileCrypto",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "minSDKVersion": 24,
      "targetSDKVersion": 33
    },
    "web": {
      "favicon": "./assets/icon2.png"
    },
    "plugins": [
      "expo-build-properties"
    ],
    "extra": {
      "eas": {
        "projectId": "337c2af9-3875-4b1c-87ab-75577e9a3805"
      }
    }
  }
}
