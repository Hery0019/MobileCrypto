# Copier en .env (ignoré par git) et renseigner avec les valeurs du projet
# Firebase visé : console Firebase → Paramètres du projet → Vos applications.
# Un projet Firebase distinct est recommandé pour le développement.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=<projet>.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=<projet>
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=<projet>.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Doit correspondre à REGION dans functions/src/admin.ts
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=europe-west1
